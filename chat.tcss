Screen {
    background: #1E1E1E;
}


/*聊天区域设置*/
#chat-view {
    background: #1E1E1E;
}


.message-row {
    width: 100%;
    height: auto;
    margin: 0;
}


.space-ai {
    width: auto;
    min-width: 10%;
    height: auto;
}

.space-usr {
    width: auto;
    min-width: 10%;
    height: auto;
}

.usr-message {
    border: round #00AFFF;
    background: #1E1E1E;
    border-title-align: right;
    width: auto;
    max-width: 90%;
    min-width: 16;
    min-height: 1;
    padding: 0;
    margin: 0;
}

.ai-message {
    border: round white;
    background: #1E1E1E;
    border-title-align: left;
    width: auto;
    max-width: 90%;
    min-width: 16;
    min-height: 1;
    padding: 0;
    margin: 0;
}


LoadingIndicator {
    height: 1;
    color: white;
}


/*输入区域设置*/

#input:focus {
    border: round #00AFFF;
}

#input {
    dock: bottom;
    border: round white;
    background: #1E1E1E;
    height: 6;
}